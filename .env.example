# Required for full AI answers (optional — local search works without it)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Auth — signs the HttpOnly session cookie. The server refuses to boot in
# production if this is left at its built-in default.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Microsoft Entra ID — the only way to sign in. There is no password login.
# Redirect URI (Web): {APP_BASE_URL}/api/auth/microsoft/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use your tenant's GUID, not "organizations" — a single-tenant registration is
# what limits sign-in to your own organization.
AZURE_TENANT_ID=
# APP_BASE_URL=http://localhost:8080
# AZURE_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
# Bootstrap admins — these emails are forced to the admin role on every sign-in
# and cannot be demoted or removed in the UI. Env-driven so it survives a DB reset.
# AZURE_ADMIN_EMAILS=manager@yourcompany.com
# Access model: anyone in the tenant can sign in and is created as an Employee
# on first login. Admins change roles on the Team page.

# Reviews — optional live sync (sample reviews load without these)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
YELP_API_KEY=
# Defaults to manhattan-project-beer-company-dallas if unset
YELP_BUSINESS_ID=manhattan-project-beer-company-dallas

# 7shifts — who is working (no schedule UI; drives notifications + end-of-shift prompts)
# Create an Access Token: 7shifts → Company Settings → Developer Tools
# Location/department from your schedule URL:
#   https://app.7shifts.com/location/204356/schedule/...?department_id=287810
SEVEN_SHIFTS_ACCESS_TOKEN=
SEVEN_SHIFTS_COMPANY_ID=
SEVEN_SHIFTS_LOCATION_ID=204356
SEVEN_SHIFTS_DEPARTMENT_ID=287810
SEVEN_SHIFTS_TIMEZONE=America/Chicago
# Optional: match shift-lead roles by name substring and/or role id
# SEVEN_SHIFTS_SHIFT_LEAD_ROLE_NAMES=shift lead,lead
# SEVEN_SHIFTS_SHIFT_LEAD_ROLE_IDS=
# SEVEN_SHIFTS_SYNC_MS=300000

PORT=8080

# SQLite location. Leave unset locally (defaults to ./training.db).
# In production this MUST point at a mounted volume or all data is lost on
# every deploy/restart — on Railway, mount a volume at /data and set:
# DB_PATH=/data/training.db

# Backups. A snapshot is taken at boot and hourly thereafter, but only when
# today's does not already exist, so restarts never skip or duplicate a day.
# Defaults to a "backups" directory beside the database, i.e. on the same
# volume — that covers a bad write or a mistaken delete, but not losing the
# volume itself.
# BACKUP_DIR=/data/backups
# BACKUP_RETENTION_DAYS=14
