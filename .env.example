# Required for full AI answers (optional — local search works without it)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Auth — signs the HttpOnly session cookie. The server refuses to boot in
# production if this is left at its built-in default.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Microsoft Entra ID — the only way to sign in. There is no password login.
# Redirect URI (Web): {APP_BASE_URL}/api/auth/microsoft/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use your tenant's GUID, not "organizations" — a single-tenant registration is
# what limits sign-in to your own organization.
AZURE_TENANT_ID=
# APP_BASE_URL=http://localhost:8080
# AZURE_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
# Bootstrap admins — these emails are forced to the admin role on every sign-in
# and cannot be demoted or removed in the UI. Env-driven so it survives a DB reset.
# AZURE_ADMIN_EMAILS=manager@manhattanproject.beer
# Only @manhattanproject.beer addresses can sign in (override with ALLOWED_EMAIL_DOMAIN).
# ALLOWED_EMAIL_DOMAIN=manhattanproject.beer
# Access model: anyone in the tenant with a company email can sign in and is
# created as bartender on first login. Admins change roles on the Team page.

# Local development without Entra. Lets you sign in as any account already in
# your local database by picking it from a list — no password, because there is
# no credential to leak or to keep working somewhere it shouldn't.
#
# Only ever set this in your own .env. It is refused three ways: the server
# exits rather than boot with it in production, the endpoints are removed from
# the public route set when it is off, and each request must arrive on the
# loopback interface. `npm run dev:local` sets it for one run without editing
# any file. Run `npm run seed` first so there are accounts to choose from.
# DEV_LOGIN=1

# Reviews — optional live sync (sample reviews load without these)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
YELP_API_KEY=
# Defaults to manhattan-project-beer-company-dallas if unset
YELP_BUSINESS_ID=manhattan-project-beer-company-dallas

# 7shifts — who is working (no schedule UI; drives notifications + end-of-shift prompts)
# Create an Access Token: 7shifts → Company Settings → Developer Tools
# Location/department from your schedule URL:
#   https://app.7shifts.com/location/204356/schedule/...?department_id=287810
SEVEN_SHIFTS_ACCESS_TOKEN=
SEVEN_SHIFTS_COMPANY_ID=
SEVEN_SHIFTS_LOCATION_ID=204356
SEVEN_SHIFTS_DEPARTMENT_ID=287810
SEVEN_SHIFTS_TIMEZONE=America/Chicago
# Optional: match shift-lead roles by name substring and/or role id
# SEVEN_SHIFTS_SHIFT_LEAD_ROLE_NAMES=shift lead,lead
# SEVEN_SHIFTS_SHIFT_LEAD_ROLE_IDS=
# SEVEN_SHIFTS_SYNC_MS=300000

# ── Nucleus ────────────────────────────────────────────────────────────────
# Where beer and tap data comes from. Required — without it the beer list,
# the pickers and the Taps tab have nothing to show.
#
# Base URL, three correct values depending on where this is running:
#   deployed on Railway   http://mpbc-nucleus.railway.internal   (never the public URL)
#   locally, reading      https://nucleus.manhattanproject.beer
#   locally, testing writes  http://localhost:<your devN Nucleus port>
NUCLEUS_BASE_URL=https://nucleus.manhattanproject.beer
# Read key (Nucleus role `staff`). Enough for the beer list and every picker.
NUCLEUS_API_KEY=
# Write key (role `manager`). ONLY needed to change what is on tap.
#
# Never put a PRODUCTION write key in a local .env. It would work, and every tap
# you changed while clicking around locally would rewrite the real taproom wall
# that every MPBC app reads. Point at a local Nucleus instead — it already has
# the same taps seeded.
# NUCLEUS_API_KEY_WRITE=
# NUCLEUS_TIMEOUT_MS=15000

PORT=8080

# SQLite location. Leave unset locally (defaults to ./training.db).
# On Railway this MUST point at a mounted volume or the app refuses to start
# and — if it somehow ran without a volume — every deploy would wipe data:
#   1. Service → Volumes → mount path /data
#   2. Variables:
#        DB_PATH=/data/training.db
#        BACKUP_DIR=/data/backups
#        BACKUP_RETENTION_DAYS=14
# DB_PATH=/data/training.db

# Backups. A snapshot is taken at boot and hourly thereafter, but only when
# today's does not already exist, so restarts never skip or duplicate a day.
# Defaults to a "backups" directory beside the database — i.e. on the same
# volume. That covers a bad write or mistaken delete, but not losing the volume.
# Copy snapshots off Railway (Drive/Dropbox) for disaster recovery.
# BACKUP_DIR=/data/backups
# BACKUP_RETENTION_DAYS=14
